rules_version = '2';

// Reglas de seguridad de Firestore para JESSDAY STYLE · Control de tiempo
// 1) Reemplaza los dos correos de ejemplo por los Gmail reales de las 2 personas.
// 2) Pega todo este contenido en Firebase → Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function autorizada() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'soporte.jessdaystyle@gmail.com',
          'jessday264@gmail.com'
        ];
    }

    // Solo esas dos personas pueden leer y escribir; cualquier otra cuenta queda bloqueada.
    match /{document=**} {
      allow read, write: if autorizada();
    }
  }
}
